{
  "name": "react-chess",
  "version": "3.0.0",
  "description": "Chess game",
  "type": "module",
  "main": "index.js",
  "engines": {
    "bun": ">=1.0.0"
  },
  "private": true,
  "scripts": {
    "lint": "eslint '{src,packages}/**/*.js'",
    "prettier": "prettier -c '{src,packages}/**/*.js'",
    "clean": "rimraf public coverage",
    "prebuild": "bun ./build.mjs",
    "build": "bun build src/index.js --outdir public --sourcemap=external && bun build src/services/worker/ai.js --outdir public --sourcemap=external",
    "prestart": "bun run build",
    "start": "bun build src/index.js --outdir public --sourcemap=external --watch & bun build src/services/worker/ai.js --outdir public --sourcemap=external --watch & http-server public -c-1",
    "prod": "bun run prebuild && bun build src/index.js --outdir public --minify && bun build src/services/worker/ai.js --outdir public --minify && http-server public -c-1",
    "prod:open": "bun run prod -- -o",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "prepare": "husky || true"
  },
  "keywords": [
    "react",
    "chess"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsveron23/react-chess"
  },
  "author": "Tony Jin <jsveron23@gmail.com>",
  "license": "MIT",
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "arrowParens": "always",
    "trailingComma": "es5",
    "bracketSpacing": true,
    "proseWrap": "always"
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "eslint": "9.x",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.6.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.34.0",
    "globals": "^17.3.0",
    "http-server": "^14.1.1",
    "prettier": "^2.5.1",
    "rimraf": "^3.0.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "classnames": "^2.3.1",
    "fast-deep-equal": "^3.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "memoize-one": "^6.0.0",
    "ramda": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.2",
    "react-spinners": "^0.12.0",
    "react-spring": "^9.4.4",
    "react-use-measure": "^2.1.1",
    "redux-undo": "^1.0.1"
  },
  "workspaces": [
    "packages/chess",
    "packages/ui"
  ],
  "lint-staged": {
    "*.js": [
      "bunx prettier --write",
      "bunx eslint --fix"
    ]
  }
}
